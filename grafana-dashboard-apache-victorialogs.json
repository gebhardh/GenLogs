    {
      "id": 10,
      "type": "timeseries",
      "title": "Requests/s nach Statusklasse",
      "description": "",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
